# Create an API consumer at https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=

# Optional. Leave blank unless your account is needed for a larger download quota.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Optional additional sources. Each source is enabled only when its key exists.
SUBDL_API_KEY=
SUBSOURCE_API_KEY=
ARABICSUBS_API_KEY=
WYZIE_API_KEY=

# Free sources that need no key (true by default). Set false to disable.
ENABLE_OPENSUBTITLES_ORG=true
ENABLE_YIFY=true
ENABLE_TVSUBTITLES=true
ENABLE_ANIKOTO=true
# Comma-separated provider ids to switch off, e.g. "mora,subkong"
DISABLED_PROVIDERS=

# Optional persistent cache that survives Render restarts / cold starts.
# Create a free Redis database at https://upstash.com and copy the REST values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Leave blank for local use or a reverse HTTPS tunnel that forwards the Host header.
# A fixed production deployment can set its public HTTPS origin here.
PUBLIC_BASE_URL=

HOST=0.0.0.0
PORT=7000
RESULT_MODE=top20
MIN_CONFIDENCE=70
MAX_RESULTS=25
DOWNLOAD_FALLBACKS=5
MAX_SEARCH_PAGES=3
DEEP_ANALYSIS_CANDIDATES=35
DEEP_ANALYSIS_TIMEOUT_MS=6500
LISTING_DEADLINE_MS=10000
PROVIDER_SEARCH_TIMEOUT_MS=5000
PROVIDER_HARD_TIMEOUT_MS=12000
BACKGROUND_VALIDATION=true
BACKGROUND_VALIDATION_TIMEOUT_MS=25000
SYNC_MIN_CONFIDENCE=0.6
ON_DEMAND_SYNC_TIMEOUT_MS=6000
COMPANION_WAIT_MS=0
# Optional overrides. Defaults to the FFmpeg binaries bundled with Stremio Service on Windows.
STREMIO_FFPROBE_PATH=
STREMIO_FFMPEG_PATH=
WHISPER_PATH=./tools/whisper/bin/Release/whisper-cli.exe
WHISPER_MODEL_PATH=./tools/whisper/ggml-base.bin
WHISPER_SAMPLE_SECONDS=60
MAX_SERIES_SUBTITLE_MINUTES=90
CACHE_TTL_SECONDS=21600
SEARCH_STALE_SECONDS=604800
VERDICT_TTL_SECONDS=1209600
CACHE_DIRECTORY=./data/cache

# Generate a long random value before exposing the server outside your LAN.
URL_TOKEN_SECRET=change-this-to-a-long-random-secret

# Preferences
ALLOW_MACHINE_TRANSLATED=false
ALLOW_BILINGUAL=true
PREFER_HEARING_IMPAIRED=false
VALIDATE_BEFORE_LISTING=true
